# Copy to .env and fill in. Every line is optional: with an empty .env the
# application uses a SQLite file and configuration C1 (controls only), which
# needs no model. docs/OPERATIONS.md explains each setting.

# --- Database ---------------------------------------------------------------
# PostgreSQL. `python scripts/pg_local.py init` writes these two lines for a
# local server; for another server write the URL yourself.
# AUDITIQ_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
# AUDITIQ_TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<test database>
#
# SQLite file, used when no URL is set (default: .auditiq/auditiq.db)
# AUDITIQ_DB=

# --- Chat model ---------------------------------------------------------------
# Any server with an OpenAI-compatible POST {base_url}/chat/completions.
#
# Local model through Ollama (no key). Create the model with the larger context
# first: ollama create qwen2.5:7b-ctx12k -f deploy/ollama/Modelfile
AUDITIQ_LLM_BASE_URL=http://localhost:11434/v1
AUDITIQ_LLM_MODEL=qwen2.5:7b-ctx12k
AUDITIQ_LLM_API_KEY=
# The server's context window in tokens. A prompt that would not fit is then
# refused instead of being cut without notice.
AUDITIQ_LLM_CONTEXT=12288
# Seconds to wait for one reply. A CPU-only machine needs a long timeout.
AUDITIQ_LLM_TIMEOUT=3600

# Hosted open-weight model: the provider's base URL, the exact model identifier
# and your key. The model identifier is stored with every result.
# AUDITIQ_LLM_BASE_URL=https://<provider>/v1
# AUDITIQ_LLM_MODEL=<model identifier>
# AUDITIQ_LLM_API_KEY=<key>

# AUDITIQ_LLM_MAX_TOKENS=700     longest reply requested
# AUDITIQ_LLM_JSON_MODE=1        set to 0 if the server rejects response_format
# AUDITIQ_LLM_SEND_SEED=1        set to 0 if the server rejects seed
# AUDITIQ_LLM_EXTRA_BODY={}      extra JSON fields for the request body

# --- Embedding model (dense policy search) -------------------------------------
# Without it the policy search is lexical. After setting it:
#   python -m auditiq policy embed
AUDITIQ_EMBED_MODEL=nomic-embed-text
# nomic-embed-text expects these prefixes; the quotes keep the trailing space.
AUDITIQ_EMBED_QUERY_PREFIX="search_query: "
AUDITIQ_EMBED_DOCUMENT_PREFIX="search_document: "
# AUDITIQ_EMBED_BASE_URL=        default: AUDITIQ_LLM_BASE_URL
# AUDITIQ_EMBED_API_KEY=         default: AUDITIQ_LLM_API_KEY

# --- Other ----------------------------------------------------------------------
# AUDITIQ_LOG_LEVEL=INFO         DEBUG also logs cache hits and connections
