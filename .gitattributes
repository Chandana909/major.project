# Text is stored with LF line endings. Documents and images are binary: a line-ending
# conversion would corrupt a PDF whose streams happen to contain no NUL byte.
* text=auto
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
*.xlsx binary
# The datasets keep LF line endings on every platform, so that the SHA-256 of each file
# in its manifest.json holds after a checkout on Windows too.
auditiq/data/** text eol=lf
